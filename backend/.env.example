DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"
JWT_ACCESS_SECRET="replace-with-strong-access-secret-key-min-32-chars"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret-key-min-32-chars"

# --- Public URLs (override per environment) ---
# FRONTEND_URL is COMMA-SEPARATED. The first entry is the primary frontend
# used for OAuth redirects; all entries are added to the CORS allow-list.
#
# Local dev (single frontend):
#   FRONTEND_URL="http://localhost:8001"
#
# Production + allow local dev to hit the deployed backend:
#   FRONTEND_URL="https://projectflow-frontend.engsiam.deno.net,http://localhost:8001,http://127.0.0.1:8001"
#
# API_PUBLIC_URL is THIS backend's public URL (no trailing slash). Used for
# OpenAPI server entries and absolute file URLs.
#   API_PUBLIC_URL="https://projectflow-backend.engsiam.deno.net"
#
# OAUTH_REDIRECT_URL is where Google/GitHub call us back. Should be
# "${API_PUBLIC_URL}/api/auth" in production.
#   OAUTH_REDIRECT_URL="https://projectflow-backend.engsiam.deno.net/api/auth"

# --- JWT lifetimes ---
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- OAuth (leave empty to disable) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Server ---
PORT="8000"
NODE_ENV="development"

# --- File storage ---
# UPLOAD_DIR is the on-disk root for the "local" STORAGE_BACKEND. Ignored
# in "db" mode.
#   UPLOAD_DIR="uploads"
#
# STORAGE_BACKEND controls where uploaded files live:
#   "local"    = local FS under UPLOAD_DIR (good for dev)
#   "db"       = MongoDB Binary (works on Deno Deploy; no FS needed)
#   "disabled" = uploads rejected with 503
# Auto-defaults to "db" on Deno Deploy and "local" elsewhere.
#   STORAGE_BACKEND="local"
