// Smart Project & Task Collaboration System - Prisma Schema
// Database: MongoDB
// Provider: prisma-client-js (compatible with Deno via npm: specifier)

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String?
  name      String
  username  String   @unique
  avatar    String?
  // Used when STORAGE_BACKEND=db: the avatar bytes live here and
  // `avatar` is set to "/api/users/{id}/avatar" (served by GET that route).
  avatarData Bytes?
  avatarMime String?
  bio       String?
  googleId  String?
  githubId  String?
  // New self-service signups (email/password AND OAuth) default to VIEWER.
  // An admin must promote the account to TEAM_MEMBER, PROJECT_MANAGER, or
  // ADMIN. This applies the principle of least privilege for new accounts.
  // Per-project roles (ProjectMember.role) default to TEAM_MEMBER separately
  // — those are scoped to a single project and unchanged here.
  role      String   @default("VIEWER") // ADMIN, PROJECT_MANAGER, TEAM_MEMBER, VIEWER
  status    String   @default("ACTIVE") // ACTIVE, DISABLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects       Project[]        @relation("ProjectOwner")
  memberships         ProjectMember[]
  sentInvitations     Invitation[]     @relation("InvitedBy")
  receivedInvitations Invitation[]     @relation("InvitedUser")
  assignedTasks       Task[]           @relation("TaskAssignee")
  createdTasks        Task[]           @relation("TaskCreator")
  comments            Comment[]
  mentions            Mention[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  activityLogs        ActivityLog[]    @relation("ActivityActor")
  attachments         Attachment[]     @relation("AttachmentUploader")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([expiresAt])
  @@index([userId, revoked])
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  color       String    @default("#6366f1")
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD, ARCHIVED
  ownerId     String    @db.ObjectId
  owner       User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  invitations Invitation[]
  tasks       Task[]
  activities  ActivityLog[]
  healthSnapshots ProjectHealthSnapshot[]
  startDate   DateTime?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([ownerId])
  @@index([ownerId, status])
}

// ============================================================
// PROJECT HEALTH INSIGHTS
// ============================================================
// AI-powered project health scoring. Each snapshot is computed by the
// health-score service and cached here for trend analysis. The score
// blends five weighted signals: overdue tasks, recent completion
// velocity, deadline proximity, member engagement, and workload
// distribution. Risk levels and human-readable insights are derived
// from the metrics and surface in the dashboard + project detail UI.

model ProjectHealthSnapshot {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId              String   @db.ObjectId
  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Overall 0-100 score
  score                  Int
  // ON_TRACK | AT_RISK | CRITICAL
  riskLevel              String

  // Weighted metric breakdown (also persisted for trend analysis)
  metrics                Json

  // [{ type: "warning" | "info" | "success" | "critical", title, text }]
  insights               Json

  // Predictive analytics
  predictedCompletionDate DateTime?
  onTrackProbability     Float

  computedAt             DateTime @default(now())

  @@index([projectId, computedAt])
  @@index([riskLevel])
}

model ProjectMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("TEAM_MEMBER") // ADMIN, PROJECT_MANAGER, TEAM_MEMBER, VIEWER
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model Invitation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String   @db.ObjectId
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email        String
  role         String   @default("TEAM_MEMBER") // ADMIN, PROJECT_MANAGER, TEAM_MEMBER, VIEWER
  token        String   @unique
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  invitedById  String   @db.ObjectId
  invitedBy    User     @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUserId String? @db.ObjectId
  invitedUser  User?    @relation("InvitedUser", fields: [invitedUserId], references: [id])
  message      String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([invitedUserId])
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String     @db.ObjectId
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String     @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assigneeId  String?    @db.ObjectId
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String     @db.ObjectId
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  dueDate     DateTime?
  labels      String[]
  order       Int        @default(0)
  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([priority])
  @@index([projectId, status, order])
  @@index([assigneeId, projectId, status])
  @@index([projectId, dueDate, status])
  @@index([projectId, assigneeId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([projectId, updatedAt])
  @@index([projectId, createdAt])
}

model Attachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId       String   @db.ObjectId
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String   @db.ObjectId
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  fileName     String   // original filename
  storedName   String   // disk filename (UUID + ext); for db storage this is "db"
  mimeType     String
  fileSize     Int      // bytes
  // "local" = file lives on the local FS at `storagePath`
  // "db"   = file bytes are stored in the `data` field (no FS access required)
  // "r2" / "s3" = reserved for future object-storage drivers
  storageType  String   @default("local")
  storagePath  String   // uploads/attachments/... (local) or "db" (db)
  data         Bytes?   // raw file bytes when storageType === "db"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId, createdAt])
}

// ============================================================
// COMMENTS & MENTIONS
// ============================================================

model Comment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  authorId  String    @db.ObjectId
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  taskId    String    @db.ObjectId
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentions  Mention[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  edited    Boolean   @default(false)

  @@index([taskId, createdAt])
}

model Mention {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String   @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================================
// ACTIVITY LOG
// ============================================================

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String   @db.ObjectId
  actor      User     @relation("ActivityActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String   @db.ObjectId
  projectId  String?  @db.ObjectId
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String?  @db.ObjectId
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}
