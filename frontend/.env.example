# Backend API base URL.
#
# Used by the Fresh server (Deno) to build absolute URLs for OAuth redirects
# and CORS-validated callbacks. The client bundle falls back to this value
# via the hardcoded default in `lib/constants.ts` (Fresh's browser polyfill
# makes Deno.env.get() return undefined).
#
# Examples:
#   API_BASE_URL=http://localhost:8000/api
#   API_BASE_URL=https://api.projectflow.dev/api
API_BASE_URL=http://localhost:8000/api
